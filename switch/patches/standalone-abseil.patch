diff --git a/absl/flags/reflection.cc b/absl/flags/reflection.cc
index ea856ff..25a7fb3 100644
--- a/absl/flags/reflection.cc
+++ b/absl/flags/reflection.cc
@@ -190,7 +190,13 @@ void ForEachFlag(std::function<void(CommandLineFlag&)> visitor) {
 // --------------------------------------------------------------------
 
 bool RegisterCommandLineFlag(CommandLineFlag& flag, const char* filename) {
-  FlagRegistry::GlobalRegistry().RegisterFlag(flag, filename);
+  // NSMBW (Switch port): abseil's registry faults during static initialisation on Horizon with an
+  // instruction abort, which takes the whole process down before main(). The game runtime never
+  // reads or writes absl flags, so registration is skipped instead of being left to break startup.
+  // GetFlag/SetFlag would find nothing registered; nothing in the port calls them.
+  // See docs/switch-handoff.md.
+  (void)flag;
+  (void)filename;
   return true;
 }
 
