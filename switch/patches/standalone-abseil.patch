 void FlagImpl::SetCallback(const FlagCallbackFunc mutation_callback) {
-  absl::MutexLock l(DataGuard());
-
-  if (callback_ == nullptr) {
-    callback_ = new FlagCallback;
-  }
-  callback_->func = mutation_callback;
-
-  InvokeCallback();
+  // NSMBW (Switch port): this runs during static initialisation for every ABSL_FLAG in the link,
+  // and acquiring the flag's absl::Mutex there aborts with an instruction fault on Horizon (see
