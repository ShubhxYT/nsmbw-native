 #define ABSL_HAVE_MMAP 1
 #endif
 
diff --git a/absl/base/internal/sysinfo.cc b/absl/base/internal/sysinfo.cc
index 79eaba3..6123e04 100644
--- a/absl/base/internal/sysinfo.cc
+++ b/absl/base/internal/sysinfo.cc
@@ -141,6 +141,9 @@ static int GetNumCPUs() {
   return hardware_concurrency ? hardware_concurrency : 1;
 #elif defined(_AIX)
   return sysconf(_SC_NPROCESSORS_ONLN);
+#elif defined(__SWITCH__)
+  // Every Switch model exposes four application cores; Horizon has no sysconf for this.
+  return 4;
 #else
   // Other possibilities:
   //  - Read /sys/devices/system/cpu/online and use cpumask_parse()
@@ -461,6 +464,15 @@ pid_t GetTID() {
   return reinterpret_cast<pid_t>(thread);
 }
 
+#elif defined(__SWITCH__)
+
+// Horizon has no gettid and its pthread_t is an opaque struct pointer. The numeric thread id is the
+// one libnx assigns, which is what GetTID's callers use it for (identity and diagnostics).
+pid_t GetTID() {
+  // pthread_t is an opaque pointer here; its address is a stable per-thread identifier.
+  return static_cast<pid_t>((reinterpret_cast<uintptr_t>(pthread_self()) >> 4) & 0x7fffffff);
+}
+
 #else
 
 // Fallback implementation of `GetTID` using `pthread_self`.
