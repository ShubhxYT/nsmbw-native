+// Which family's names the runtime prints for a physical button. Auto keeps the positional
+// label that names both families ("South (A / Cross)"); the others print one family only, so
+// a player can see their own pad's names even when detection guesses wrong.
+enum class Layout : int32_t { Auto = 0, PlayStation = 1, Xbox = 2, Nintendo = 3 };
+
+inline Layout& LayoutStorage() {
+    static Layout value = Layout::Auto;
+    return value;
+}
+
+inline Layout GetLayout() {
+    return LayoutStorage();
+}
+
+inline void SetLayout(Layout value) {
+    LayoutStorage() = value;
+}
+
+// The label to draw for a physical input under the current layout.
+inline std::string LabelFor(const NativeButtonItem& item) {
+    const Layout layout = GetLayout();
+    if (layout == Layout::Auto) {
+        return item.label;
+    }
+    struct Entry {
+        const char* key;
+        const char* playstation;
+        const char* xbox;
+        const char* nintendo;
+    };
+    static constexpr Entry kEntries[] = {
+        {"south", "Cross (\u2715)", "A", "B"},
+        {"east", "Circle (\u25CB)", "B", "A"},
+        {"west", "Square (\u25A1)", "X", "Y"},
+        {"north", "Triangle (\u25B3)", "Y", "X"},
+        {"back", "Create", "View", "\u2212"},
+        {"start", "Options", "Menu", "+"},
+        {"guide", "PS", "Guide", "Home"},
+        {"left_shoulder", "L1", "LB", "L"},
+        {"right_shoulder", "R1", "RB", "R"},
+        {"left_trigger", "L2", "LT", "ZL"},
+        {"right_trigger", "R2", "RT", "ZR"},
+        {"left_stick", "L3", "L3", "L3"},
+        {"right_stick", "R3", "R3", "R3"},
+        {"misc1", "Share", "Share", "Mic"},
+        {"touchpad", "Touchpad", "Touchpad", "Touchpad"},
+    };
+    const std::string_view key = item.configName;
+    for (const auto& entry : kEntries) {
+        if (key != entry.key) {
+            continue;
+        }
+        switch (layout) {
+        case Layout::PlayStation: return entry.playstation;
+        case Layout::Xbox: return entry.xbox;
+        case Layout::Nintendo: return entry.nintendo;
+        default: break;
+        }
+    }
+    return item.label;
+}
+
+inline std::string LabelForValue(uint32_t nativeButton) {
+    return LabelFor(NativeButtonForValue(nativeButton));
+}
