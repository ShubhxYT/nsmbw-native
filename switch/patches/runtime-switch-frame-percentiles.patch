+#if defined(NSMBW_USE_DEKO3D)
+    // Quarter-millisecond buckets plus a final bucket for frames of 128 ms or longer.
+    std::array<uint32_t, 513> frameDurationCounts{};
+
+    void CountDuration(double ms) {
+        const auto bucket = static_cast<size_t>(std::min(ms * 4, 512.0));
+        ++frameDurationCounts[bucket];
+    }
+
+    size_t Percentile95Bucket() const {
+        const auto rank = static_cast<uint32_t>(frames - frames / 20);
+        uint32_t cumulative = 0;
+        for (size_t i = 0; i < frameDurationCounts.size(); ++i) {
+            cumulative += frameDurationCounts[i];
+            if (cumulative >= rank) {
+                return i;
+            }
+        }
+        return frameDurationCounts.size() - 1;
+    }
 #endif
 };

